---
import { asset } from '../lib/site';

interface Props {
  file: string;
  width: number;
  height: number;
  caption: string;
  alt: string;
}

const { file, width, height, caption, alt } = Astro.props;
---

<figure>
  <a href={asset(file)}>
    <img src={asset(file)} alt={alt} width={width} height={height} loading="lazy" />
  </a>
  <figcaption>{caption}</figcaption>
</figure>
