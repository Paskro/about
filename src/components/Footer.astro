---
import type en from '../content/en.json';
import { CONTACT_EMAIL, LINKEDIN_URL, TELEGRAM_HANDLE, TELEGRAM_URL } from '../config';

interface Props {
  content: typeof en;
}

const { footer } = Astro.props.content;
---

<footer class="site-footer">
  <div class="wrap">
    <h2>{footer.title}</h2>
    <ul>
      <li><a href={TELEGRAM_URL} rel="me noopener">{footer.telegram} {TELEGRAM_HANDLE}</a></li>
      <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
      <li><a href={LINKEDIN_URL} rel="me noopener">{footer.linkedin}</a></li>
      <li><a href="https://paskro.com/">paskro.com</a></li>
    </ul>
  </div>
</footer>
