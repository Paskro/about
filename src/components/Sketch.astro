---
// A slot for a hand-drawn marker sketch. Drop the PNG into public/img/ under the given name;
// until then a small doodle is shown. Sketches are decorative, so they are hidden from screen readers.
import { asset, hasPublicFile } from '../lib/site';

interface Props {
  file: string;
  class?: string;
}

const { file, class: className } = Astro.props;
const exists = hasPublicFile(file);
---

<div class:list={['sketch', className]} aria-hidden="true">
  {
    exists ? (
      <img src={asset(file)} alt="" width="800" height={file.includes('hero') ? 440 : 520} loading="lazy" />
    ) : (
      <svg viewBox="0 0 160 120">
        <rect class="sketch-frame" x="6" y="6" width="148" height="108" rx="22" />
        <path class="sketch-coral" d="M30 78c10-34 24 22 36-8s16-22 24-6" />
        <path class="sketch-teal" d="M94 66l14 14 26-36" />
      </svg>
    )
  }
</div>
